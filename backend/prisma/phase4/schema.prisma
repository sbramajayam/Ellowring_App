  modules        CourseModule[]
  assignments    Assignment[]
  assessments    Assessment[]
  certificates   CourseCertificate[]
  downloads      CourseDownload[]
  enrollments    CourseEnrollment[]

  @@index([categoryId])
  @@index([trainingCenterId])
