}

model SmsLog {
  id           String   @id @default(cuid())
  userId       String?
  phone        String
  message      String
  status       String   @default("QUEUED")
  providerRef  String?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([phone])
  @@index([status])
  @@map("sms_logs")
}

model PushNotification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  body        String
  deviceToken String?
  status      String   @default("QUEUED")
  providerRef String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("push_notifications")
}

model WhatsappLog {
  id           String   @id @default(cuid())
  userId       String?
  phone        String
  message      String
  template     String?
  status       String   @default("QUEUED")
  providerRef  String?
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([phone])
  @@index([status])
  @@map("whatsapp_logs")
}
