  deletedAt   DateTime?

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluations ProjectEvaluation[]

  @@index([projectId])
  @@index([studentId])
  @@index([status])
  @@map("project_submissions")
}

model ProjectEvaluation {
  id           String   @id @default(cuid())
  submissionId String
  evaluatorId  String?
  score        Decimal  @db.Decimal(6, 2)
  maxScore     Int      @default(100)
  feedback     String?
  evaluatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("project_evaluations")
}

// ─── JOB ───────────────────────────────────────────────────────────────────────

model HrUser {
  id          String    @id @default(cuid())
  userId      String    @unique
  companyId   String
  designation String?
  department  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobs       Job[]
  interviews Interview[]

  @@index([companyId])
  @@map("hr_users")
}

model Job {
  id          String         @id @default(cuid())
  companyId   String
  hrUserId    String?
  title       String
  slug        String         @unique
  location    String?
  type        EmploymentType @default(FULL_TIME)
  mode        WorkMode       @default(HYBRID)
  salaryMin   Decimal?       @db.Decimal(14, 2)
  salaryMax   Decimal?       @db.Decimal(14, 2)
  currency    String         @default("INR")
  experience  String?
  description String?
  skills      String?
  openings    Int            @default(1)
  isActive    Boolean        @default(true)
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hrUser       HrUser?          @relation(fields: [hrUserId], references: [id], onDelete: SetNull)
  applications JobApplication[]
  savedBy      SavedJob[]
  interviews   Interview[]
  offers       JobOffer[]

  @@index([companyId])
  @@index([hrUserId])
  @@index([isActive])
  @@map("jobs")
}

model JobApplication {
  id          String            @id @default(cuid())
  userId      String
  jobId       String
  status      ApplicationStatus @default(PENDING)
  coverLetter String?
  resumeUrl   String?
  appliedAt   DateTime          @default(now())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  interviews  Interview[]
  offers      JobOffer[]

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([status])
  @@map("job_applications")
}

model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model Interview {
  id            String          @id @default(cuid())
  jobId         String
  applicationId String
  hrUserId      String?
  scheduledAt   DateTime
  durationMin   Int             @default(45)
  mode          WorkMode        @default(REMOTE)
  meetingUrl    String?
  status        InterviewStatus @default(SCHEDULED)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  hrUser      HrUser?        @relation(fields: [hrUserId], references: [id], onDelete: SetNull)

  @@index([jobId])
  @@index([applicationId])
  @@index([scheduledAt])
  @@map("interviews")
}

model JobOffer {
  id            String         @id @default(cuid())
  jobId         String
  applicationId String
  salary        Decimal        @db.Decimal(14, 2)
  currency      String         @default("INR")
  joiningDate   DateTime?
  status        JobOfferStatus @default(PENDING)
  offeredAt     DateTime       @default(now())
  respondedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  job         Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  application JobApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([applicationId])
  @@index([status])
  @@map("job_offers")
}

model Employee {
  id          String    @id @default(cuid())
  companyId   String
  employeeNo  String
  name        String
  email       String?
  phone       String?
  designation String?
  department  String?
  salary      Decimal?  @db.Decimal(14, 2)
  currency    String    @default("INR")
  joinedAt    DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollItems PayrollItem[]

  @@unique([companyId, employeeNo])
  @@index([companyId])
  @@map("employees")
}

model PayrollRun {
  id          String           @id @default(cuid())
  companyId   String?
  periodStart DateTime
  periodEnd   DateTime
  status      PayrollRunStatus @default(DRAFT)
  totalAmount Decimal?         @db.Decimal(14, 2)
  currency    String           @default("INR")
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  items PayrollItem[]

  @@index([periodStart, periodEnd])
  @@index([status])
  @@map("payroll_runs")
}

model PayrollItem {
  id           String   @id @default(cuid())
  payrollRunId String
  employeeId   String
  grossPay     Decimal  @db.Decimal(14, 2)
  deductions   Decimal  @default(0) @db.Decimal(14, 2)
  netPay       Decimal  @db.Decimal(14, 2)
  currency     String   @default("INR")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, employeeId])
  @@index([payrollRunId])
  @@index([employeeId])
  @@map("payroll_items")
}

// ─── TRAINING ──────────────────────────────────────────────────────────────────

model TrainingCenter {
  id          String    @id @default(cuid())
  userId      String    @unique
  name        String
  specialty   String?
  city        String?
  state       String?
  website     String?
  description String?
  logoUrl     String?
  verified    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  trainers  Trainer[]
  programs  TrainingProgram[]
  courses   Course[]
  revenue   TrainingRevenue[]

  @@index([city, state])
  @@map("training_centers")
}

model Trainer {
  id               String    @id @default(cuid())
  trainingCenterId String
  name             String
  email            String?
  phone            String?
  specialty        String?
  bio              String?
  avatarUrl        String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  trainingCenter TrainingCenter   @relation(fields: [trainingCenterId], references: [id], onDelete: Cascade)
  batches        TrainingBatch[]

  @@index([trainingCenterId])
  @@map("trainers")
}

model TrainingProgram {
  id               String    @id @default(cuid())
  trainingCenterId String
  title            String
  slug             String    @unique
  description      String?
  duration         String?
  price            Decimal   @default(0) @db.Decimal(14, 2)
  currency         String    @default("INR")
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  trainingCenter TrainingCenter   @relation(fields: [trainingCenterId], references: [id], onDelete: Cascade)
  batches        TrainingBatch[]
  assignments    TrainingAssignment[]

  @@index([trainingCenterId])
  @@map("training_programs")
}

model TrainingBatch {
  id          String    @id @default(cuid())
  programId   String
  trainerId   String?
  name        String
  startDate   DateTime
  endDate     DateTime?
  capacity    Int       @default(30)
  enrolled    Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  program    TrainingProgram      @relation(fields: [programId], references: [id], onDelete: Cascade)
  trainer    Trainer?             @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  attendance AttendanceRecord[]

  @@index([programId])
  @@index([trainerId])
  @@map("training_batches")
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  batchId   String
  studentId String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  notes     String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  batch   TrainingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId, date])
  @@index([batchId])
  @@index([studentId])
  @@map("attendance_records")
}

model TrainingAssignment {
  id          String    @id @default(cuid())
  programId   String
  studentId   String
  title       String
  description String?
  dueDate     DateTime?
  submittedAt DateTime?
  score       Decimal?  @db.Decimal(6, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([studentId])
  @@map("training_assignments")
}

model TrainingRevenue {
  id               String   @id @default(cuid())
  trainingCenterId String
  periodMonth      Int
  periodYear       Int
  grossRevenue     Decimal  @db.Decimal(14, 2)
  netRevenue       Decimal  @db.Decimal(14, 2)
  currency         String   @default("INR")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trainingCenter TrainingCenter @relation(fields: [trainingCenterId], references: [id], onDelete: Cascade)

  @@unique([trainingCenterId, periodMonth, periodYear])
  @@index([trainingCenterId])
  @@map("training_revenue")
}

// ─── PARTNER ───────────────────────────────────────────────────────────────────

model Partner {
  id            String    @id @default(cuid())
  userId        String    @unique
  name          String
  region        String?
  referralCode  String    @unique
  commissionPct Decimal   @default(10) @db.Decimal(5, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  leads     PartnerLead[]
  referrals Referral[]
  wallet    PartnerWallet?
  commissions Commission[]
  payouts   Payout[]
  reports   PartnerReport[]

  @@index([referralCode])
  @@map("partners")
}

model PartnerLead {
  id          String    @id @default(cuid())
  partnerId   String
  name        String
  email       String?
  phone       String?
  source      String?
  status      String    @default("NEW")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@map("partner_leads")
}

model Referral {
  id           String   @id @default(cuid())
  partnerId    String
  referredEmail String
  referredUserId String?
  status       String   @default("PENDING")
  convertedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  partner    Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([partnerId])
  @@index([referredEmail])
  @@map("referrals")
}

model PartnerWallet {
  id        String    @id @default(cuid())
  partnerId String    @unique
  balance   Decimal   @default(0) @db.Decimal(14, 2)
  currency  String    @default("INR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@map("partner_wallets")
}

model Commission {
  id         String           @id @default(cuid())
  partnerId  String
  referralId String?
  amount     Decimal          @db.Decimal(14, 2)
  currency   String           @default("INR")
  status     CommissionStatus @default(PENDING)
  earnedAt   DateTime         @default(now())
  paidAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  partner  Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  payouts  Payout[]

  @@index([partnerId])
  @@index([referralId])
  @@index([status])
  @@map("commissions")
}

model Payout {
  id           String       @id @default(cuid())
  partnerId    String
  commissionId String?
  amount       Decimal      @db.Decimal(14, 2)
  currency     String       @default("INR")
  status       PayoutStatus @default(PENDING)
  reference    String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  partner    Partner     @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  commission Commission? @relation(fields: [commissionId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([commissionId])
  @@index([status])
  @@map("payouts")
}

model PartnerReport {
  id          String   @id @default(cuid())
  partnerId   String
  reportType  String
  periodStart DateTime
  periodEnd   DateTime
  data        Json
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([reportType])
  @@map("partner_reports")
}

// ─── ADMIN ─────────────────────────────────────────────────────────────────────

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

model Configuration {
  id        String   @id @default(cuid())
  namespace String
  key       String
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([namespace, key])
  @@index([namespace])
  @@map("configurations")
}

model Report {
  id          String   @id @default(cuid())
  title       String
  reportType  String
  parameters  Json?
  fileUrl     String?
  generatedBy String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([reportType])
  @@index([generatedAt])
  @@map("reports")
}

model AnalyticsSnapshot {
  id         String   @id @default(cuid())
  metricKey  String
  metricValue Decimal @db.Decimal(18, 4)
  dimensions Json?
  capturedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([metricKey])
  @@index([capturedAt])
  @@map("analytics_snapshots")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  targetRole  Role?
  isPublished Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([isPublished])
  @@index([targetRole])
  @@map("announcements")
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  imageUrl    String
  linkUrl     String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([isActive])
  @@map("banners")
}

model CmsPage {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  content     String
  metaTitle   String?
  metaDesc    String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([isPublished])
  @@map("cms_pages")
}

model SupportTicket {
  id           String         @id @default(cuid())
  userId       String
  assigneeId   String?
  subject      String
  description  String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  category     String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  user     User  @relation("TicketRequester", fields: [userId], references: [id], onDelete: Cascade)
  assignee User? @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([assigneeId])
  @@index([status])
  @@map("support_tickets")
}

// ─── PAYMENT ───────────────────────────────────────────────────────────────────

model PremiumPlan {
  id           String    @id @default(cuid())
  name         String    @unique
  slug         String    @unique
  description  String?
  price        Decimal   @db.Decimal(14, 2)
  currency     String    @default("INR")
  billingCycle String    @default("MONTHLY")
  features     Json?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  subscriptions Subscription[]

  @@map("premium_plans")
}

model Subscription {
  id         String             @id @default(cuid())
  userId     String
  planId     String
  status     SubscriptionStatus @default(TRIAL)
  startDate  DateTime           @default(now())
  endDate    DateTime?
  trialEndsAt DateTime?
  cancelledAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan PremiumPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id        String        @id @default(cuid())
  userId    String
  amount    Decimal       @db.Decimal(14, 2)
  currency  String        @default("INR")
  status    PaymentStatus @default(PENDING)
  provider  String        @default("RAZORPAY")
  reference String?       @unique
  purpose   String?
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  transactions Transaction[]
  refunds      Refund[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("payments")
}

model Invoice {
  id            String        @id @default(cuid())
  paymentId     String?
  invoiceNo     String        @unique
  userId        String?
  amount        Decimal       @db.Decimal(14, 2)
  taxAmount     Decimal       @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal       @db.Decimal(14, 2)
  currency      String        @default("INR")
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime?
  dueDate       DateTime?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([status])
  @@map("invoices")
}

model Transaction {
  id          String          @id @default(cuid())
  paymentId   String
  type        TransactionType
  amount      Decimal         @db.Decimal(14, 2)
  currency    String          @default("INR")
  providerRef String?
  status      PaymentStatus   @default(PENDING)
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("transactions")
}

model Refund {
  id          String        @id @default(cuid())
  paymentId   String
  amount      Decimal       @db.Decimal(14, 2)
  currency    String        @default("INR")
  reason      String?
  status      PaymentStatus @default(PENDING)
  providerRef String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([status])
  @@map("refunds")
}

// ─── NOTIFICATION ──────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(INFO)
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean          @default(false)
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model EmailLog {
