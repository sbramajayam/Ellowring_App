// Ellowring Phase-4 PostgreSQL Schema
// Compatible with docs/Ellowring_Database_Design.md
// Swap: set DATABASE_URL to postgres, replace root schema.prisma with this, npx prisma migrate dev

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  COLLEGE
  COMPANY
  TRAINING
  PARTNER
  ADMIN
}

enum AdmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
  WAITLISTED
  WITHDRAWN
}

enum AbroadApplicationStatus {
  DRAFT
  SUBMITTED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  VISA_PROCESSING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  TRIAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

enum TransactionType {
  CREDIT
  DEBIT
  REFUND
  ADJUSTMENT
}

enum WalletLedgerType {
  CREDIT
  DEBIT
  HOLD
  RELEASE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ALERT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum InternshipOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum JobOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum PayrollRunStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELLED
  EXPIRED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
  ESSAY
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
  EXPERT
}

enum ProjectSubmissionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUESTED
  APPROVED
  REJECTED
}

enum OtpPurpose {
  LOGIN
  REGISTER
  RESET_PASSWORD
  VERIFY_EMAIL
  VERIFY_PHONE
  TWO_FACTOR
}

enum BookmarkEntityType {
  COURSE
  COLLEGE
  JOB
  INTERNSHIP
  PROJECT
  COACHING_PROGRAM
  ABROAD_PROGRAM
  ARTICLE
}

enum FavoriteEntityType {
  COURSE
  COLLEGE
  JOB
  INTERNSHIP
  PROJECT
  COACHING_PROGRAM
  TRAINER
  COMPANY
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  name         String
  role         Role      @default(STUDENT)
  avatarUrl    String?
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  student         Student?
  collegeProfile  CollegeProfile?
  company         Company?
  trainingCenter  TrainingCenter?
  partner         Partner?
  hrUser          HrUser?

  sessions         Session[]
  refreshTokens    RefreshToken[]
  otpVerifications OtpVerification[]
  passwordResets   PasswordReset[]
  auditLogs        AuditLog[]
  rbacAssignments  UserRbacRole[]

  notifications      Notification[]
  payments           Payment[]
  subscriptions      Subscription[]
  supportTickets     SupportTicket[]     @relation("TicketRequester")
  assignedTickets    SupportTicket[]     @relation("TicketAssignee")
  couponRedemptions  CouponRedemption[]
  abroadApplications AbroadApplication[]
  collegeApplications CollegeApplication[]
  jobApplications    JobApplication[]
  internshipApplications InternshipApplication[]
  savedJobs          SavedJob[]
  emailLogs          EmailLog[]
  smsLogs            SmsLog[]
  pushNotifications  PushNotification[]
  whatsappLogs       WhatsappLog[]

  @@index([role])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

model RbacRole {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RbacRolePermission[]
  users       UserRbacRole[]

  @@map("roles")
}

model Permission {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  module      String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  roles RbacRolePermission[]

  @@index([module])
  @@map("permissions")
}

model RbacRolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRbacRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_rbac_roles")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model OtpVerification {
  id        String     @id @default(cuid())
  userId    String?
  email     String?
  phone     String?
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  used      Boolean    @default(false)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([email])
  @@index([phone])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_resets")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── STUDENT ─────────────────────────────────────────────────────────────────

model Student {
  id          String    @id @default(cuid())
  userId      String    @unique
  dateOfBirth DateTime?
  gender      String?
  grade       String?
  stream      String?
  city        String?
  state       String?
  country     String?   @default("IN")
  bio         String?
  resumeUrl   String?
  linkedinUrl String?
  githubUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  parents               Parent[]
  educationHistory      EducationHistory[]
  careerInterests       CareerInterest[]
  careerRecommendations CareerRecommendation[]
  studentSkills         StudentSkill[]
  skillProgress         SkillProgress[]
  achievements          Achievement[]
  wallet                Wallet?
  certificates          Certificate[]
  bookmarks             Bookmark[]
  favorites             Favorite[]

  coachingEnrollments   CoachingEnrollment[]
  courseEnrollments     CourseEnrollment[]
  studentAnswers        StudentAnswer[]
  mockResults           MockResult[]
  leaderboardEntries    LeaderboardEntry[]
  internshipApplications InternshipApplication[]
  internshipProgress    InternshipProgress[]
  internshipFeedback    InternshipFeedback[]
  projectTeamMembers    ProjectTeamMember[]
  projectSubmissions    ProjectSubmission[]
  trainingAssignments   TrainingAssignment[]
  attendanceRecords     AttendanceRecord[]

  @@index([city, state])
  @@index([deletedAt])
  @@map("students")
}

model Parent {
  id           String    @id @default(cuid())
  studentId    String
  name         String
  relation     String
  email        String?
  phone        String?
  occupation   String?
  isPrimary    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("parents")
}

model EducationHistory {
  id           String    @id @default(cuid())
  studentId    String
  institution  String
  degree       String?
  fieldOfStudy String?
  startYear    Int?
  endYear      Int?
  grade        String?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("education_history")
}

model CareerInterest {
  id        String    @id @default(cuid())
  studentId String
  title     String
  category  String?
  priority  Int       @default(1)
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  recommendations CareerRecommendation[]

  @@index([studentId])
  @@map("career_interests")
}

model CareerRecommendation {
  id               String    @id @default(cuid())
  studentId        String
  careerInterestId String?
  title            String
  summary          String?
  confidence       Decimal?  @db.Decimal(5, 2)
  source           String?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  careerInterest CareerInterest? @relation(fields: [careerInterestId], references: [id], onDelete: SetNull)

  @@index([studentId])
  @@index([careerInterestId])
  @@map("career_recommendations")
}

model Skill {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  category    String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  studentSkills StudentSkill[]
  skillProgress SkillProgress[]

  @@index([category])
  @@map("skills")
}

model StudentSkill {
  id           String    @id @default(cuid())
  studentId    String
  skillId      String
  level        Int       @default(1)
  yearsOfExp   Decimal?  @db.Decimal(4, 1)
  verified     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([studentId, skillId])
  @@index([studentId])
  @@index([skillId])
  @@map("student_skills")
}

model SkillProgress {
  id          String    @id @default(cuid())
  studentId   String
  skillId     String
  progressPct Int       @default(0)
  source      String?
  notes       String?
  recordedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([skillId])
  @@map("skill_progress")
}

model Achievement {
  id          String    @id @default(cuid())
  studentId   String
  title       String
  description String?
  issuer      String?
  achievedAt  DateTime?
  badgeUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("achievements")
}

model Wallet {
  id        String    @id @default(cuid())
  studentId String    @unique
  balance   Decimal   @default(0) @db.Decimal(14, 2)
  currency  String    @default("INR")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ledger  WalletLedger[]

  @@map("wallets")
}

model WalletLedger {
  id          String           @id @default(cuid())
  walletId    String
  amount      Decimal          @db.Decimal(14, 2)
  type        WalletLedgerType
  reference   String?
  description String?
  balanceAfter Decimal?        @db.Decimal(14, 2)
  createdAt   DateTime         @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
  @@map("wallet_ledger")
}

model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  title         String?
  discountPct   Decimal?  @db.Decimal(5, 2)
  discountAmt   Decimal?  @db.Decimal(14, 2)
  minOrderAmt   Decimal?  @db.Decimal(14, 2)
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdById   String?
  updatedById   String?

  redemptions CouponRedemption[]

  @@index([isActive])
  @@index([expiresAt])
  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderRef  String?
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_redemptions")
}

model Certificate {
  id           String    @id @default(cuid())
  studentId    String
  title        String
  issuer       String
  credentialId String?
  fileUrl      String?
  issuedAt     DateTime  @default(now())
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("certificates")
}

model Bookmark {
  id         String             @id @default(cuid())
  studentId  String
  entityType BookmarkEntityType
  entityId   String
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, entityType, entityId])
  @@index([studentId])
  @@index([entityType, entityId])
  @@map("bookmarks")
}

model Favorite {
  id         String             @id @default(cuid())
  studentId  String
  entityType FavoriteEntityType
  entityId   String
  createdAt  DateTime           @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, entityType, entityId])
  @@index([studentId])
  @@index([entityType, entityId])
  @@map("favorites")
}

// ─── COACHING ──────────────────────────────────────────────────────────────────

model CoachingCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  iconUrl     String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  programs CoachingProgram[]

  @@map("coaching_categories")
}

model CoachingProgram {
  id          String    @id @default(cuid())
  categoryId  String
  title       String
  slug        String    @unique
  examType    String
  description String?
  price       Decimal   @default(0) @db.Decimal(14, 2)
  duration    String?
  batchSize   Int?
  thumbnail   String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  category    CoachingCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subjects    Subject[]
  mockTests   MockTest[]
  enrollments CoachingEnrollment[]

  @@index([categoryId])
  @@index([examType])
  @@index([isPublished])
  @@map("coaching_programs")
}

model CoachingEnrollment {
  id        String           @id @default(cuid())
  studentId String
  programId String
  status    EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime        @default(now())
  completedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program CoachingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([studentId, programId])
  @@index([studentId])
  @@index([programId])
  @@map("coaching_enrollments")
}

model Subject {
  id          String    @id @default(cuid())
  programId   String
  name        String
  slug        String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  program  CoachingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([programId, slug])
  @@index([programId])
  @@map("subjects")
}

model Chapter {
  id          String    @id @default(cuid())
  subjectId   String
  title       String
  slug        String
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  subject Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("chapters")
}

model Lesson {
  id          String    @id @default(cuid())
  chapterId   String
  title       String
  slug        String
  content     String?
  videoUrl    String?
  durationMin Int?
  sortOrder   Int       @default(0)
  isFree      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([chapterId, slug])
  @@index([chapterId])
  @@map("lessons")
}

model Topic {
  id          String    @id @default(cuid())
  lessonId    String
  title       String
  content     String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("topics")
}

model QuestionBank {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  examType    String?
  description String?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  questions Question[]
  mockTests MockTest[]

  @@index([examType])
  @@map("question_banks")
}

model MockTest {
  id            String    @id @default(cuid())
  programId     String?
  questionBankId String?
  title         String
  slug          String    @unique
  durationMin   Int
  totalMarks    Int
  passingMarks  Int?
  isPublished   Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  program      CoachingProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  questionBank QuestionBank?    @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  questions    Question[]
  results      MockResult[]
  leaderboard  LeaderboardEntry[]

  @@index([programId])
  @@index([questionBankId])
  @@map("mock_tests")
}

model Question {
  id             String          @id @default(cuid())
  questionBankId String?
  mockTestId     String?
  text           String
  type           QuestionType    @default(MCQ)
  difficulty     DifficultyLevel @default(MEDIUM)
  marks          Int             @default(1)
  explanation    String?
  sortOrder      Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  questionBank QuestionBank?    @relation(fields: [questionBankId], references: [id], onDelete: SetNull)
  mockTest     MockTest?        @relation(fields: [mockTestId], references: [id], onDelete: SetNull)
  options      QuestionOption[]
  answers      StudentAnswer[]

  @@index([questionBankId])
  @@index([mockTestId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  label      String
  text       String
  isCorrect  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  StudentAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model StudentAnswer {
  id               String   @id @default(cuid())
  studentId        String
  questionId       String
  selectedOptionId String?
  textAnswer       String?
  isCorrect        Boolean?
  marksAwarded     Decimal? @db.Decimal(6, 2)
  answeredAt       DateTime @default(now())
  createdAt        DateTime @default(now())

